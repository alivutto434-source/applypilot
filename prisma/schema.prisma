// ApplyPilot — Prisma schema (PostgreSQL / Supabase)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AppStatus {
  DRAFTED
  SENT
  SKIPPED_MISMATCH
  FAILED
}

enum LogLevel {
  INFO
  AI
  EMAIL
  SUCCESS
  WARN
  ERROR
}

/// Every job you paste into ApplyPilot becomes a row here.
/// The full job description + source URL are always persisted.
model JobApplication {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  jobTitle        String?
  companyName     String?
  jobDescription  String
  sourceUrl       String?
  recruiterEmail  String?
  /// Where the recruiter address came from: manual | description | fetched
  recruiterSource String?

  matchScore      Int?
  isMatch         Boolean?
  matchReasoning  String?

  status          AppStatus @default(DRAFTED)
  emailSubject    String?
  /// Plain-text body (also the text/plain part of the email)
  emailBody       String?
  /// Rich-text body produced by the AI and/or edited in the UI
  emailBodyHtml   String?
  emailSentAt     DateTime?
  cvAttached      Boolean   @default(false)
  aiModel         String?
  errorMessage    String?

  logs            ActivityLog[]

  @@index([status])
  @@index([createdAt])
}

/// Colourful, verbose pipeline log feed shown in the UI.
model ActivityLog {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  level         LogLevel @default(INFO)
  stage         String
  message       String
  applicationId String?
  application   JobApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  meta          Json?

  @@index([createdAt])
  @@index([applicationId])
}

/// Single-row global configuration (id = "singleton").
/// Secrets (SMTP password, AI key) stay in .env — never in the DB.
model Settings {
  id              String   @id @default("singleton")
  cvText          String   @default("")
  cvFileName      String?

  /// Plain-text mirror of signatureHtml (text/plain part of the email)
  signature       String   @default("")
  /// Rich-text (HTML) signature — bold, links, lists. ONE signature only.
  signatureHtml   String   @default("")

  senderName      String   @default("")
  defaultSubject  String   @default("Application for {{jobTitle}} at {{companyName}}")

  // ---- Mail sending flags (mirrored to localStorage for instant UI) ----
  /// Keep generated applications as drafts instead of sending them.
  flagDraft               Boolean @default(true)
  /// Send automatically. Only takes effect when flagDraft is OFF.
  flagAutoSend            Boolean @default(false)
  /// Try to discover the recruiter address from the source URL / description.
  flagFetchRecruiterEmail Boolean @default(false)
  /// Let the AI write subject + body (off = you write it yourself).
  flagAutoGenerateEmail   Boolean @default(true)
  /// Attach the master CV PDF to every outgoing email.
  attachCv                Boolean @default(true)

  strictness      String   @default("balanced") // strict | balanced | lenient
  aiModel         String   @default("openai/gpt-4o-mini")
  minMatchScore   Int      @default(60)
  updatedAt       DateTime @updatedAt
}
