# --- Database (Supabase free tier) -----------------------------------------
# Transaction pooler, port 6543 (runtime)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler, port 5432 (prisma db push / migrate). Optional but recommended.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres"

# --- AI (OpenRouter) -------------------------------------------------------
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="ApplyPilot"

# --- SMTP ------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="you@gmail.com"
SMTP_PASS="your gmail app password"
SMTP_FROM_NAME="Your Name"
